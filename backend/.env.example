MONGODB_URI=mongodb://localhost:27017/smart-panchayat
JWT_SECRET=your_jwt_secret_key_here_change_in_production
PORT=5000
NODE_ENV=development

# OpenAI (optional - chatbot falls back to local knowledge base if not set)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase FCM (optional - push notifications disabled if not set)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Auto-escalation (days before a pending complaint is escalated)
ESCALATION_DAYS=7
