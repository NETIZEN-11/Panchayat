# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart-panchayat?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_random_secret_here_min_32_chars

# ─── OpenAI (Optional - chatbot AI responses) ─────────────────
# Get from: https://platform.openai.com/api-keys
# If not set, chatbot uses local knowledge base fallback
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Firebase FCM (Optional - push notifications) ─────────────
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key exactly as-is (with \n newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ─── CORS ─────────────────────────────────────────────────────
# For production: your Render URL or * for all
FRONTEND_URL=*

# ─── Auto-escalation ──────────────────────────────────────────
# Days before a pending complaint gets escalated
ESCALATION_DAYS=7
